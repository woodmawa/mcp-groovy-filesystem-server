<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        MCP FILESYSTEM SERVER - LOGGING CONFIGURATION
        ==============================================
        CANONICAL PATTERN FOR ALL MCP STDIO SERVERS:

        - STDERR ONLY. No file appender.
          Claude Desktop captures stderr from each MCP server process and writes it to:
          %APPDATA%/Roaming/Claude/logs/mcp-server-{name}.log
          That IS the log file. Do not create separate rolling file appenders.

        - STDOUT is reserved exclusively for MCP JSON-RPC messages.
          Never write to stdout. Always use System.err target.

        - claude-sync/logs/ is for Syncthing jar distribution only. No logs there.
        - ~/.mcp-logs/ is ABOLISHED. Do not write there.
    -->

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>

    <logger name="com.softwood.mcp" level="DEBUG"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.boot" level="WARN"/>
</configuration>
